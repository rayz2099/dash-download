{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dash Download",
  "version": "1.2.1",
  "identifier": "dev.ray.dash-download",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm --dir ui dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "pnpm --dir ui build",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dash Download",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGOEEyRDc2OTA5QTA2RgpSV1J2b0FscDE2TDRBUXdCMzVMV3hMUDB3VmNhcWJxOU4xUWttdXNUTUVRcVVidVAxMW0vb1JabAo=",
      "endpoints": [
        "http://127.0.0.1:41320/api/updater-manifest"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
